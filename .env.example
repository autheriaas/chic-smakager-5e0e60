# Configure these in Netlify. Never commit real values.
# Apps Script deployment URL. Use a TEST spreadsheet for local writes.
APPS_SCRIPT_URL=
# Generate a NEW random secret (at least 32 characters). Must match the
# BACKEND_SECRET Script Property in Apps Script. Never use the old admin secrets.
BACKEND_SECRET=
# Canonical HTTPS origin, also configured as SITE_URL in Apps Script.
SITE_URL=
# Existing chatbot integration.
GEMINI_API_KEY=
